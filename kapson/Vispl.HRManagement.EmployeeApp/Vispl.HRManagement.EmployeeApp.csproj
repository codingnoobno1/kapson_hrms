<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Vispl.HRManagement.EmployeeApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- A separate app id from the HR app: two apps, two icons, two installs on one phone. -->
    <ApplicationTitle>Kapsons</ApplicationTitle>
    <ApplicationId>com.kapsons.employee</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <!-- No Fast Deployment: every managed assembly is packed into the APK, so the device never
         looks in the stale .__override__ directory for assemblies. -->
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <!-- Pack assemblies as individual files rather than one bundled store blob (full binaries). -->
    <AndroidUseAssemblyStore Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidUseAssemblyStore>
    <!-- UseSystemResourceKeys intentionally removed: it stripped exception-message strings from
         System.Private.CoreLib, and on a non-neutral device culture (e.g. en-IN) the resource
         manager recursed while formatting an early exception and aborted the process on load. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FF6153" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FF6153" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vispl.HRManagement.Mobile.Client\Vispl.HRManagement.Mobile.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.0" />

    <!--
      Syncfusion. Toolkit carries SfBottomSheet, which the plan's whole detail pattern rests on;
      Calendar carries SfCalendar for the month grid; Core carries the shared primitives both
      depend on. Nothing else is referenced, so an unused control cannot bloat the package.
    -->
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.11" />
    <PackageReference Include="Syncfusion.Maui.Core" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Maui.Calendar" Version="34.2.7" />
    <PackageReference Include="Syncfusion.Maui.Charts" Version="34.2.7" />
  </ItemGroup>

</Project>
