<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Vispl.HRManagement.EmployeeApp.Features.Authentication.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="28,80,28,28" Spacing="0">

            <Label
                Text="KAPSONS"
                FontSize="30"
                FontAttributes="Bold"
                CharacterSpacing="3"
                TextColor="#111827"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,44" />

            <Label
                Text="Set a new password"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#111827"
                Margin="0,0,0,4" />

            <Label
                Text="Replace the temporary password HR gave you before you continue."
                FontSize="13"
                TextColor="#8C8C8C"
                Margin="0,0,0,24" />

            <Label Text="Current password" FontSize="11" TextColor="#8C8C8C" Margin="0,0,0,4" />
            <Border Stroke="#F2F2F2" StrokeThickness="1" BackgroundColor="#F6F6F6" Padding="12,2" Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry
                    x:Name="CurrentPasswordEntry"
                    IsPassword="True"
                    ReturnType="Next"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#111827"
                    Completed="OnCurrentCompleted"
                    SemanticProperties.Description="Current password" />
            </Border>

            <Label Text="New password" FontSize="11" TextColor="#8C8C8C" Margin="0,0,0,4" />
            <Border Stroke="#F2F2F2" StrokeThickness="1" BackgroundColor="#F6F6F6" Padding="12,2" Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry
                    x:Name="NewPasswordEntry"
                    IsPassword="True"
                    ReturnType="Next"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#111827"
                    Completed="OnNewCompleted"
                    SemanticProperties.Description="New password" />
            </Border>

            <Label Text="Confirm new password" FontSize="11" TextColor="#8C8C8C" Margin="0,0,0,4" />
            <Border Stroke="#F2F2F2" StrokeThickness="1" BackgroundColor="#F6F6F6" Padding="12,2" Margin="0,0,0,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry
                    x:Name="ConfirmPasswordEntry"
                    IsPassword="True"
                    ReturnType="Go"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#111827"
                    Completed="OnSaveClicked"
                    SemanticProperties.Description="Confirm new password" />
            </Border>

            <Label
                Text="At least 10 characters, with an uppercase letter, a lowercase letter, a number and a symbol."
                FontSize="11"
                TextColor="#8C8C8C"
                Margin="0,0,0,8" />

            <Label
                x:Name="ErrorLabel"
                FontSize="12"
                TextColor="#FF6153"
                IsVisible="False"
                Margin="0,0,0,8" />

            <Button
                x:Name="SaveButton"
                Text="Save and continue"
                BackgroundColor="#FF6153"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                FontAttributes="Bold"
                Margin="0,12,0,0"
                Clicked="OnSaveClicked" />

            <ActivityIndicator
                x:Name="Busy"
                Color="#FF6153"
                IsVisible="False"
                IsRunning="False"
                Margin="0,16,0,0" />

            <Button
                x:Name="SignOutButton"
                Text="Sign out"
                BackgroundColor="Transparent"
                TextColor="#8C8C8C"
                FontSize="13"
                Margin="0,20,0,0"
                Clicked="OnSignOutClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
