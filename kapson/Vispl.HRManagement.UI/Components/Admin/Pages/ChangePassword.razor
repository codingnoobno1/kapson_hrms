@page "/admin/change-password"
@attribute [Authorize(Policy = "AdminAuthenticated")]

<PageTitle>Change Password | Vertex HR</PageTitle>
<div class="admin-login-page">
    <section class="admin-login-brand"><span class="admin-login-mark">V</span><div><span class="admin-kicker">ACCOUNT SECURITY</span><h1>Create your private administrator password.</h1><p>The supplied bootstrap password is temporary and cannot access the Admin modules.</p></div></section>
    <section class="admin-login-panel">
        <form class="admin-login-card" method="post" action="/identity/admin/change-password">
            <AntiforgeryToken />
            <span class="admin-kicker">REQUIRED</span><h2>Change password</h2><p>Use at least 10 characters with uppercase, lowercase, number and symbol.</p>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="admin-alert error">@ErrorMessage</div> }
            <label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required /></label>
            <label>New password<input name="newPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
            <label>Confirm new password<input name="confirmPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
            <button class="admin-button primary admin-login-submit" type="submit">Change password and continue</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private string? ErrorMessage => Error switch
    {
        null or "" => null,
        "mismatch" => "The new password and confirmation do not match.",
        _ => Uri.UnescapeDataString(Error)
    };
}
