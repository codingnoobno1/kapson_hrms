@page "/hr/change-password"
@page "/hr/{TenantKey}/change-password"
@attribute [Authorize(Policy = "HrAuthenticated")]
@inject NavigationManager Navigation

<PageTitle>Change password | HR Portal</PageTitle>

<div class="hr-login">
    <section class="hr-login-panel">
        <span class="hr-kicker">HR PORTAL</span>
        <h1>Choose a new password</h1>
        <p>@Prompt</p>

        @if (ErrorMessage is not null)
        {
            <div class="hr-alert error">@ErrorMessage</div>
        }

        <form method="post" action="/identity/hr/change-password" class="hr-login-form">
            <AntiforgeryToken />
            <label>Current password
                <input name="currentPassword" type="password" autocomplete="current-password" required autofocus />
            </label>
            <label>New password
                <input name="newPassword" type="password" autocomplete="new-password" required />
                <small>At least 10 characters, with upper case, lower case, a digit and a symbol.</small>
            </label>
            <label>Confirm new password
                <input name="confirmPassword" type="password" autocomplete="new-password" required />
            </label>
            <button class="hr-button" type="submit">Change password</button>
        </form>
    </section>
</div>

@code {
    [Parameter] public string? TenantKey { get; set; }

    private string? ErrorMessage;

    private const string Prompt =
        "A new password is required before the portal can be used.";

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        ErrorMessage = error.ToString() == "mismatch"
            ? "The two new passwords do not match."
            : error.ToString();
    }
}
