    private RenderFragment StatusSelect(string current, Action<string> set, bool includePayment = false) => __builder =>
    {
        <select value="@current" @onchange="args => set(args.Value?.ToString() ?? string.Empty)">
            <option value="">All Status</option>
            <option value="@PayrollLineStatuses.Generated">Generated</option>
            <option value="@PayrollLineStatuses.Pending">Pending</option>
            @if (includePayment)
            {
                <option value="@PayrollLineStatuses.Paid">Paid</option>
                <option value="@PayrollLineStatuses.Transferred">Transferred</option>
            }
        </select>
    };

    private static RenderFragment StatusPill(string status) => __builder =>
    {
        <span class="pay-status @status.ToLowerInvariant()">● @status</span>
    };

    private static RenderFragment AmountCells(PayrollAmountsDto amounts, bool deductionsInRed = false) => __builder =>
    {
        <td>@Rupees(amounts.Basic)</td>
        <td>@Rupees(amounts.Hra)</td>
        <td>@Rupees(amounts.Conveyance)</td>
        <td>@Rupees(amounts.OtherAllowances)</td>
        <td>@Rupees(amounts.Gross)</td>
        <td class="@(deductionsInRed ? "pay-minus" : null)">@Rupees(amounts.Pf)</td>
        <td class="@(deductionsInRed ? "pay-minus" : null)">@Rupees(amounts.Esi)</td>
        <td class="@(deductionsInRed ? "pay-minus" : null)">@Rupees(amounts.Tds)</td>
        <td class="@(deductionsInRed ? "pay-minus" : null)">@Rupees(amounts.OtherDeductions)</td>
        <td class="pay-net">@Rupees(amounts.NetPayable)</td>
    };

    /// <summary>A row's Generate: everyone in the row who is pending or only generated.</summary>
    private RenderFragment RowGenerate(IEnumerable<EmployeePayrollRowDto> members) => __builder =>
    {
        var ids = members
            .Where(member => member.Status is PayrollLineStatuses.Pending or PayrollLineStatuses.Generated && member.PendingReason is null)
            .Select(member => member.EmployeeId)
            .ToList();

        <button class="pay-btn outline small" type="button" disabled="@(!CanGenerate || IsBusy || ids.Count == 0)"
                title="Generate or regenerate this row's salaries" @onclick="() => GenerateAsync(ids)">📄 Generate</button>
    };

    private string? GenerateHint() =>
        !CanManage ? "Needs PAYROLL.MANAGE"
        : Workspace?.Run.IsApproved == true ? "This month is approved and locked"
        : null;

    private string Href(string suffix) =>
        string.IsNullOrWhiteSpace(TenantKey) ? $"/hr/{suffix}" : $"/hr/{TenantKey}/{suffix}";

    private bool Contains(string? value) =>
        string.IsNullOrWhiteSpace(Search) || (value?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    private static bool Same(string? left, string? right) =>
        string.Equals(left ?? string.Empty, right ?? string.Empty, StringComparison.OrdinalIgnoreCase);

    public static string Rupees(decimal amount) => string.Format(India, "₹{0:N0}", amount);

    /// <summary>The tile's compact figure: ₹42.6L, ₹1.2Cr.</summary>
    private static string Lakhs(decimal amount) => amount switch
    {
        >= 10_000_000m => $"₹{amount / 10_000_000m:0.##}Cr",
        >= 100_000m => $"₹{amount / 100_000m:0.#}L",
        _ => Rupees(amount)
    };

    public static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    public static int AvatarTone(string name) => Math.Abs(name.Aggregate(17, (hash, character) => hash * 31 + character)) % 6;

    private static IReadOnlyList<MasterOptionDto> ActiveOptions(IReadOnlyList<MasterOptionDto> options, string category) =>
        options.Where(option => option.Category == category && option.IsActive)
            .OrderBy(option => option.SortOrder).ThenBy(option => option.Name)
            .ToList();
}
