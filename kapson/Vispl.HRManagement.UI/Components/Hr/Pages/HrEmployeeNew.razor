    private string ActiveSection = SecPersonal;
    private EmployeeWorkspaceDto Model = new();
    private IReadOnlyList<MasterOptionDto> AllOptions = [];
    private IReadOnlyList<DesignationDto> DesignationList = [];
    private IReadOnlyList<GradeSalaryStructureDto> GradeStructures = [];
    private IReadOnlyList<CompanyBankAccountDto> CompanyAccounts = [];
    private IReadOnlyList<EmployeeExplorerRowDto> AllEmployees = [];

    private long? LoadedEmployeeId = -1;
    private bool IsLoading = true;
    private bool IsSaving;
    private bool SavingDraft;
    private bool IsUploadingPhoto;
    private bool CanEdit;
    private bool ShowSalaryChart;
    private string? LoadError;
    private string? SaveError;

    // Inline editors
    private EmployeeEducationItemDto? EduEditor;
    private int EditingEduIndex = -1;

    private EmployeePreviousCompanyItemDto? PrevEditor;
    private int EditingPrevIndex = -1;

    private EmployeeSalaryAllowanceRowDto CompEditor = new();
    private int EditingCompIndex = -1;

    private bool IsEditing => EmployeeId is > 0;

    private string EmployeeLabel
    {
        get
        {
            var full = $"{Model.Personal.FirstName} {Model.Personal.LastName}".Trim();
            return string.IsNullOrWhiteSpace(full) ? Model.Personal.EmployeeNumber : full;
        }
    }

    private string PageHeading => IsEditing ? $"Employee — {EmployeeLabel}" : "New Employee";

    private IEnumerable<MasterOptionDto> TopDepartments =>
        Options(MasterCategories.Department).Where(o => string.IsNullOrWhiteSpace(o.ParentCode));

    private IEnumerable<MasterOptionDto> SubDepartments =>
        string.IsNullOrWhiteSpace(Model.Personal.DepartmentCode)
            ? []
            : Options(MasterCategories.Department).Where(o => Same(o.ParentCode, Model.Personal.DepartmentCode));

    private IEnumerable<EmployeeExplorerRowDto> ManagerCandidates =>
        AllEmployees.Where(e => e.IsActive && !e.IsDraft && e.EmployeeId != EmployeeId?.ToString(CultureInfo.InvariantCulture));

    private decimal TotalAllowances =>
        Model.Salary.Components.Where(c => c.Kind == SalaryComponentKinds.Allowance).Sum(c => c.CalculatedAmount);

    private decimal GrossSalary => Model.Salary.BasicSalary + TotalAllowances;

    private decimal TotalDeductions =>
        Model.Salary.Components.Where(c => c.Kind != SalaryComponentKinds.Allowance).Sum(c => c.CalculatedAmount);

    private decimal NetSalary => Math.Max(0m, GrossSalary - TotalDeductions);

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedEmployeeId == EmployeeId && !IsLoading)
        {
            return;
        }

        LoadedEmployeeId = EmployeeId;
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        IsLoading = true;
        LoadError = null;
        SaveError = null;
        EduEditor = null;
        PrevEditor = null;
        ResetComponentEditor();

        try
        {
            var caller = await PortalCaller.GetAsync();
            var canCreate = await PortalCaller.HasAsync("EMPLOYEES.CREATE");
            var canManageEmp = await PortalCaller.HasAsync("EMPLOYEES.EMPLOYMENT_MANAGE");
            var canManageOrg = await PortalCaller.HasAsync("EMPLOYEES.ORGANISATION_MANAGE");
            CanEdit = IsEditing ? (canCreate || canManageEmp || canManageOrg) : canCreate;

            AllOptions = await Masters.GetAllAsync(caller.TenantKey);
            DesignationList = (await Designations.GetAllAsync(caller.TenantKey)).Where(d => d.IsActive).ToList();
            GradeStructures = await GradeSalaries.GetAllAsync(caller.TenantKey);

            if (await PortalCaller.HasAsync("PAYROLL.VIEW"))
            {
                CompanyAccounts = (await BankAccounts.GetCompanyAccountsAsync(caller)).Where(c => c.IsActive).ToList();
            }

            if (await PortalCaller.HasAsync("EMPLOYEES.VIEW") || canCreate)
            {
                AllEmployees = await Workspace.GetExplorerAsync(caller, new EmployeeExplorerQuery());
            }

            if (IsEditing && EmployeeId is { } empId)
            {
                var loaded = await Workspace.GetWorkspaceAsync(caller, empId.ToString(CultureInfo.InvariantCulture));
                if (loaded is null)
                {
                    LoadError = "Employee record was not found.";
                    return;
                }
                Model = loaded;
            }
            else
            {
                Model = await Workspace.GetNewTemplateAsync(caller);
                ActiveSection = SecPersonal;
            }
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnDepartmentChanged(ChangeEventArgs e)
    {
        Model.Personal.DepartmentCode = e.Value?.ToString() ?? string.Empty;
        if (!SubDepartments.Any(s => Same(s.Code, Model.Personal.SubDepartmentCode)))
        {
            Model.Personal.SubDepartmentCode = null;
        }
    }

    private Task OnDesignationChangedAsync(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? string.Empty;
        Model.Personal.DesignationCode = code;

        var des = DesignationList.FirstOrDefault(d => Same(d.Code, code));
        if (des is not null)
        {
            Model.Personal.JobTitle = des.Name;
            if (string.IsNullOrWhiteSpace(Model.Personal.DepartmentCode))
            {
                Model.Personal.DepartmentCode = des.DepartmentCode;
            }

            if (!string.IsNullOrWhiteSpace(des.GradeCode) && string.IsNullOrWhiteSpace(Model.Salary.GradeCode))
            {
                ApplyGradeDefaults(des.GradeCode);
            }
        }

        return Task.CompletedTask;
    }

    private void OnSalaryGradeChanged(ChangeEventArgs e)
    {
        var gradeCode = e.Value?.ToString() ?? string.Empty;
        ApplyGradeDefaults(gradeCode);
    }

    private void ApplyGradeDefaults(string gradeCode)
    {
        Model.Salary.GradeCode = string.IsNullOrWhiteSpace(gradeCode) ? null : gradeCode;
        var structure = GradeStructures.FirstOrDefault(g => Same(g.GradeCode, gradeCode));
        if (structure is not null && structure.IsConfigured)
        {
            Model.Salary.BasicSalary = structure.BasicMonthly;
            Model.Salary.Components = structure.Components.Select(c => new EmployeeSalaryAllowanceRowDto
            {
                Code = c.ComponentCode,
                Name = c.ComponentName ?? c.ComponentCode,
                Kind = c.Kind,
                IsPercentage = c.CalculationType != SalaryCalculationTypes.Fixed,
                Amount = c.Value,
                OnBasicOrGross = c.CalculationType == SalaryCalculationTypes.PercentOfGross ? "Gross" : "Basic",
                VaryOnDays = true,
                CalculationOn = "Salary"
            }).ToList();
            Model.Salary.Recalculate();
        }
    }

    private void OnBasicSalaryChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0)
        {
            Model.Salary.BasicSalary = parsed;
            Model.Salary.Recalculate();
        }
    }

    private void OnComponentPicked(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? string.Empty;
        CompEditor.Code = code;

        var allowance = Options(MasterCategories.AllowanceType).FirstOrDefault(o => Same(o.Code, code));
        if (allowance is not null)
        {
            CompEditor.Name = allowance.Name;
            CompEditor.Kind = SalaryComponentKinds.Allowance;
            return;
        }

        var deduction = Options(MasterCategories.DeductionType).FirstOrDefault(o => Same(o.Code, code));
        if (deduction is not null)
        {
            CompEditor.Name = deduction.Name;
            CompEditor.Kind = SalaryComponentKinds.Deduction;
        }
    }

    private void CommitSalaryComponent()
    {
        if (string.IsNullOrWhiteSpace(CompEditor.Code))
        {
            return;
        }

        var item = new EmployeeSalaryAllowanceRowDto
        {
            Code = CompEditor.Code,
            Name = string.IsNullOrWhiteSpace(CompEditor.Name) ? CompEditor.Code : CompEditor.Name,
            Kind = CompEditor.Kind,
            IsPercentage = CompEditor.IsPercentage,
            Amount = CompEditor.Amount,
            OnBasicOrGross = CompEditor.OnBasicOrGross,
            VaryOnDays = CompEditor.VaryOnDays,
            CalculationOn = CompEditor.CalculationOn
        };

        if (EditingCompIndex >= 0 && EditingCompIndex < Model.Salary.Components.Count)
        {
            Model.Salary.Components[EditingCompIndex] = item;
        }
        else
        {
            Model.Salary.Components.Add(item);
        }

        Model.Salary.Recalculate();
        ResetComponentEditor();
    }

    private void EditSalaryComponent(int index)
    {
        var row = Model.Salary.Components[index];
        EditingCompIndex = index;
        CompEditor = new EmployeeSalaryAllowanceRowDto
        {
            Code = row.Code,
            Name = row.Name,
            Kind = row.Kind,
            IsPercentage = row.IsPercentage,
            Amount = row.Amount,
            OnBasicOrGross = row.OnBasicOrGross,
            VaryOnDays = row.VaryOnDays,
            CalculationOn = row.CalculationOn,
            CalculatedAmount = row.CalculatedAmount
        };
    }

    private void RemoveSalaryComponent(int index)
    {
        Model.Salary.Components.RemoveAt(index);
        Model.Salary.Recalculate();
        if (EditingCompIndex == index)
        {
            ResetComponentEditor();
        }
    }

    private void ResetComponentEditor()
    {
        EditingCompIndex = -1;
        CompEditor = new EmployeeSalaryAllowanceRowDto
        {
            IsPercentage = true,
            OnBasicOrGross = "Basic",
            VaryOnDays = true,
            CalculationOn = "Salary"
        };
    }

    // ---- Education editor ---------------------------------------------------

    private void StartAddEducation()
    {
        EditingEduIndex = -1;
        EduEditor = new EmployeeEducationItemDto { PassingYear = DateTime.Today.Year };
    }

    private void EditEducation(int index)
    {
        var row = Model.Education[index];
        EditingEduIndex = index;
        EduEditor = new EmployeeEducationItemDto
        {
            Id = row.Id,
            QualificationCode = row.QualificationCode,
            EducationLevelCode = row.EducationLevelCode,
            Specialisation = row.Specialisation,
            Institute = row.Institute,
            BoardOrUniversity = row.BoardOrUniversity,
            PassingYear = row.PassingYear,
            Cgpa = row.Cgpa,
            GradeLetter = row.GradeLetter,
            Percentage = row.Percentage,
            CertificationName = row.CertificationName,
            CertificationValidTill = row.CertificationValidTill,
            IsHighest = row.IsHighest
        };
    }

    private void CommitEducation()
    {
        if (EduEditor is null) return;
        if (string.IsNullOrWhiteSpace(EduEditor.Institute))
        {
            SaveError = "Enter the Institute / University Name for the education entry.";
            return;
        }
        SaveError = null;

        if (EditingEduIndex >= 0 && EditingEduIndex < Model.Education.Count)
        {
            Model.Education[EditingEduIndex] = EduEditor;
        }
        else
        {
            Model.Education.Add(EduEditor);
        }

        EduEditor = null;
        EditingEduIndex = -1;
    }

    private void CancelEducation()
    {
        EduEditor = null;
        EditingEduIndex = -1;
    }

    private void RemoveEducation(int index) => Model.Education.RemoveAt(index);

