    }

    private void EditPreviousCompany(int index)
    {
        var row = Model.PreviousCompanies[index];
        EditingPrevIndex = index;
        PrevEditor = new EmployeePreviousCompanyItemDto
        {
            Id = row.Id,
            CompanyName = row.CompanyName,
            Designation = row.Designation,
            Department = row.Department,
            PreviousEmployeeId = row.PreviousEmployeeId,
            JoinedOn = row.JoinedOn,
            LeftOn = row.LeftOn,
            EmploymentType = row.EmploymentType,
            LastAnnualCtc = row.LastAnnualCtc,
            ReportingManagerName = row.ReportingManagerName,
            LeavingReasonCode = row.LeavingReasonCode,
            NoticeServed = row.NoticeServed,
            Remarks = row.Remarks
        };
    }

    private void CommitPreviousCompany()
    {
        if (PrevEditor is null) return;
        if (string.IsNullOrWhiteSpace(PrevEditor.CompanyName))
        {
            SaveError = "Enter the Company Name for the previous employment entry.";
            return;
        }
        if (PrevEditor.LeftOn < PrevEditor.JoinedOn)
        {
            SaveError = "Leaving Date cannot be earlier than Joining Date.";
            return;
        }
        SaveError = null;

        if (EditingPrevIndex >= 0 && EditingPrevIndex < Model.PreviousCompanies.Count)
        {
            Model.PreviousCompanies[EditingPrevIndex] = PrevEditor;
        }
        else
        {
            Model.PreviousCompanies.Add(PrevEditor);
        }

        PrevEditor = null;
        EditingPrevIndex = -1;
    }

    private void CancelPreviousCompany()
    {
        PrevEditor = null;
        EditingPrevIndex = -1;
    }

    private void RemovePreviousCompany(int index) => Model.PreviousCompanies.RemoveAt(index);

    // ---- Documents & Photo upload -------------------------------------------

    private void AddDocumentRow() => Model.Documents.Add(new EmployeeDocumentItemDto());

    private void RemoveDocumentRow(int index)
    {
        Model.Documents.RemoveAt(index);
        if (Model.Documents.Count == 0)
        {
            Model.Documents.Add(new EmployeeDocumentItemDto());
        }
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        SaveError = null;
        IsUploadingPhoto = true;

        try
        {
            var file = e.File;
            var caller = await PortalCaller.GetAsync();
            await using var stream = file.OpenReadStream(5L * 1024 * 1024);
            var uploaded = await Workspace.UploadMediaAsync(caller, file.Name, file.ContentType, file.Size, stream, imageOnly: true);
            Model.Personal.AvatarUrl = uploaded.PublicUrl;
            Toast.Success("Profile photo uploaded.");
        }
        catch (Exception ex)
        {
            SaveError = ex.Message;
        }
        finally
        {
            IsUploadingPhoto = false;
        }
    }

    private async Task UploadDocumentRowAsync(int index, InputFileChangeEventArgs e)
    {
        if (index < 0 || index >= Model.Documents.Count) return;
        SaveError = null;

        try
        {
            var file = e.File;
            var caller = await PortalCaller.GetAsync();
            await using var stream = file.OpenReadStream(10L * 1024 * 1024);
            var uploaded = await Workspace.UploadMediaAsync(caller, file.Name, file.ContentType, file.Size, stream, imageOnly: false);

            var row = Model.Documents[index];
            row.MediaAssetId = uploaded.MediaAssetId;
            row.FileName = uploaded.FileName;
            row.PublicUrl = uploaded.PublicUrl;
            if (string.IsNullOrWhiteSpace(row.DocumentType))
            {
                row.DocumentType = Path.GetFileNameWithoutExtension(file.Name);
            }
            Toast.Success($"Uploaded \"{uploaded.FileName}\".");
        }
        catch (Exception ex)
        {
            SaveError = ex.Message;
        }
    }

    // ---- Save Draft / Submit ------------------------------------------------

    private async Task SaveAsync(bool asDraft)
    {
        IsSaving = true;
        SavingDraft = asDraft;
        SaveError = null;

        try
        {
            var caller = await PortalCaller.GetAsync();
            var savedId = await Workspace.SaveWorkspaceAsync(caller, Model, asDraft);
            Model.EmployeeId = savedId;
            Model.IsDraft = asDraft;

            var label = $"{Model.Personal.FirstName} {Model.Personal.LastName}".Trim();
            if (asDraft)
            {
                Toast.Success($"Draft saved for {label}.");
                if (!IsEditing && long.TryParse(savedId, NumberStyles.Integer, CultureInfo.InvariantCulture, out var newId))
                {
                    LoadedEmployeeId = newId;
                    Navigation.NavigateTo(Href($"employees/{newId}"), replace: true);
                }
            }
            else
            {
                Toast.Success($"Employee {label} ({Model.Personal.EmployeeNumber}) saved successfully.");
                Navigation.NavigateTo(Href("people"));
            }
        }
        catch (MobileAccessDeniedException denied)
        {
            SaveError = $"Permission required: {denied.Permission}.";
        }
        catch (Exception ex)
        {
            SaveError = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private IEnumerable<MasterOptionDto> Options(string category) =>
        AllOptions.Where(o => o.Category == category && o.IsActive)
            .OrderBy(o => o.SortOrder).ThenBy(o => o.Name);

    private string OptionName(string category, string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "—";
        return AllOptions.FirstOrDefault(o => o.Category == category && Same(o.Code, code))?.Name ?? code;
    }

    private static bool Same(string? left, string? right) =>
        string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private string Href(string suffix) =>
        string.IsNullOrWhiteSpace(TenantKey) ? $"/hr/{suffix}" : $"/hr/{TenantKey}/{suffix}";
}
