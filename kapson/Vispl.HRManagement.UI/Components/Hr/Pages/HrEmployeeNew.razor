    [
        new(SecPersonal, "Personal Details", "user"),
        new(SecEducation, "Education Details", "graduation-cap"),
        new(SecPreviousCompany, "Previous Company", "building"),
        new(SecBank, "Bank Details", "landmark"),
        new(SecPfEsi, "PF/ESI Details", "clipboard-list"),
