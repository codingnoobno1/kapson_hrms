@page "/hr/employees/hierarchy"
@page "/hr/{TenantKey}/employees/hierarchy"
@attribute [Authorize(Policy = "HrPortal")]
@using Vispl.HRManagement.BM.ITF.Admin
@using Vispl.HRManagement.BM.ITF.Mobile
@using Vispl.HRManagement.Contracts.Admin
@using Vispl.HRManagement.UI.Components.Hr.Shared
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IEmployeeReportService Reports
@inject IEmployeeWorkspaceService Workspace
@inject IMasterDataService Masters
@inject HrPortalCaller PortalCaller
@inject IJSRuntime JS

<PageTitle>Organization Hierarchy | HR Portal</PageTitle>

<div class="hr-app">
    <HrNav ActivePage="people" TenantKey="@TenantKey" />

    <main class="hr-page">
        <h1 class="hr-title-blue">Organization Hierarchy</h1>
        <nav class="hr-breadcrumb" aria-label="Breadcrumb">
            <a href="@Href("dashboard")">Dashboard</a>
            <span aria-hidden="true"><HrIcon Name="chevron-right" Size="15" StrokeWidth="2.2" /></span>
            <strong>Organization Hierarchy</strong>
        </nav>

        <HrEmployeeTabs ActiveTab="hierarchy" TenantKey="@TenantKey" />

        @if (LoadError is not null)
        {
            <div class="hr-alert error">@LoadError</div>
        }
        else
        {
            <section class="hr-panel emp-explorer-card emp-mt-sm">
                <div class="emp-explorer-toolbar">
                    <div class="emp-explorer-filters">
                        <label class="emp-field">
                            <span class="emp-label">Division</span>
                            <select value="@DivisionCode" @onchange="args => ChangeAsync(() => DivisionCode = Text(args))">
                                <option value="">All Divisions</option>
                                @foreach (var option in Options(MasterCategories.Division))
                                {
                                    <option @key="option.Code" value="@option.Code">@option.Name</option>
                                }
                            </select>
                        </label>
                        <label class="emp-field">
                            <span class="emp-label">Department</span>
                            <select value="@DepartmentCode" @onchange="args => ChangeAsync(() => DepartmentCode = Text(args))">
                                <option value="">All Departments</option>
                                @foreach (var option in Options(MasterCategories.Department).Where(d => string.IsNullOrWhiteSpace(d.ParentCode)))
                                {
                                    <option @key="option.Code" value="@option.Code">@option.Name</option>
                                }
                            </select>
                        </label>
                        <label class="emp-field">
                            <span class="emp-label">Status</span>
                            <select value="@Status" @onchange="args => ChangeAsync(() => Status = Text(args))">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="">Everyone</option>
                            </select>
                        </label>
                        <label class="emp-field">
                            <span class="emp-label">Search</span>
                            <input type="search" placeholder="Name, number or title…" value="@Search"
                                   @onchange="args => ChangeAsync(() => Search = Text(args))" />
                        </label>
                    </div>
                    <div class="emp-explorer-actions">
                        <a class="hr-button small" href="@Href("employees/new")">
                            <HrIcon Name="plus" Size="14" StrokeWidth="2.4" /> Add New Employee
                        </a>
                    </div>
                </div>

                @if (IsLoading)
                {
                    <p class="hr-empty">Loading organization hierarchy…</p>
                }
                else if (Hierarchy is { } org)
                {
                    <section class="org-tiles">
                        <div><span>Employees</span><strong>@org.TotalEmployees</strong></div>
                        <div><span>Managers</span><strong>@org.ManagerCount</strong><small>with direct reports</small></div>
                        <div class="@(org.WithoutManager > 0 ? "warn" : null)"><span>No manager recorded</span><strong>@org.WithoutManager</strong></div>
                        <div><span>Reporting levels</span><strong>@org.MaxDepth</strong></div>
                    </section>

                    @if (org.TotalEmployees > 0 && org.ManagerCount == 0)
                    {
                        <div class="hr-alert warning compact">
                            No reporting lines are recorded yet, so everyone appears at the top level. Set "Reporting to Manager" on each employee from Employees Explorer.
                        </div>
                    }

                    <div class="pay-tabs" role="tablist">
                        <button type="button" role="tab" class="@(View == OrgView.Chart ? "active" : null)" @onclick="ShowChart">
                            📊 Org chart <span>@org.TotalEmployees</span>
                        </button>
                        <button type="button" role="tab" class="@(View == OrgView.Reporting ? "active" : null)" @onclick="() => View = OrgView.Reporting">
                            🧭 Reporting lines <span>@org.ReportingRoots.Count</span>
                        </button>
                        <button type="button" role="tab" class="@(View == OrgView.Divisions ? "active" : null)" @onclick="() => View = OrgView.Divisions">
                            🏢 By division <span>@org.Divisions.Count</span>
                        </button>
                    </div>

                    <div class="org-panel">
                        @if (org.TotalEmployees == 0)
                        {
                            <p class="hr-empty">Nobody matches these filters.</p>
                        }
                        else if (View == OrgView.Chart)
                        {
                            <div class="ocx-shell" id="@ChartElementId">
                                <div class="ocx-toolbar">
                                    <span class="ocx-toolbar-title"><i>⛬</i> Organisation Chart</span>
                                    <span class="ocx-divider"></span>
                                    <div class="ocx-search">
                                        <input type="text" placeholder="Search name, code or title…" autocomplete="off" />
                                        <button type="button" data-oc="clear" title="Clear search">✕</button>
                                    </div>
                                    <button type="button" class="ocx-btn" data-oc="focus" title="Show only the selected person's team">🔍 Focus</button>
                                    <button type="button" class="ocx-btn" data-oc="reset" title="Show the whole organisation">↻ Reset</button>
                                    <button type="button" class="ocx-btn" data-oc="expand">Expand all</button>
                                    <button type="button" class="ocx-btn" data-oc="collapse">Collapse all</button>
                                    <div class="ocx-right">
                                        <button type="button" class="ocx-btn" data-oc="png">🖼 PNG</button>
                                        <button type="button" class="ocx-btn" data-oc="pdf">📄 PDF</button>
                                        <button type="button" class="ocx-btn" data-oc="print">🖨 Print</button>
                                        <span class="ocx-divider"></span>
                                        <button type="button" class="ocx-btn" data-oc="fit" title="Fit the chart to the screen">⤢ Fit</button>
                                        <div class="ocx-zoom">
                                            <input type="range" min="15" max="150" value="100" aria-label="Zoom" />
                                            <span>100%</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="ocx-legend">
                                    @foreach (var dept in LegendDepartments(org))
                                    {
                                        <span @key="dept.Code"><i style="background:@DeptColor(dept.Code)"></i>@dept.Name</span>
                                    }
                                </div>
                                <div class="ocx-breadcrumb" hidden></div>
                                <div class="ocx-viewport">
                                    <div class="ocx-inner"></div>
                                </div>
                                <div class="ocx-hint">Click a card to see its reporting line · double-click to open the employee · right-click for team actions · drag to pan · Ctrl + scroll to zoom</div>
                                <div class="ocx-toast" hidden></div>
                            </div>
                        }
                        else if (View == OrgView.Reporting)
                        {
                            <div class="org-tree-tools">
                                <button class="hr-button small ghost" type="button" @onclick="ExpandAll">Expand all</button>
                                <button class="hr-button small ghost" type="button" @onclick="() => CollapseAll(org)">Collapse all</button>
                            </div>
                            <ul class="org-tree">
                                @foreach (var root in org.ReportingRoots)
                                {
                                    @NodeView(root)
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="org-divisions">
                                @foreach (var division in org.Divisions)
                                {
                                    <article class="org-division" @key="division.DivisionCode">
                                        <header>
                                            <h3>🏢 @division.DivisionName</h3>
                                            <span>@division.EmployeeCount</span>
                                        </header>
                                        @foreach (var department in division.Departments)
                                        {
                                            <div class="org-department" @key="division.DivisionCode + department.DepartmentCode">
                                                <h4>📁 @department.DepartmentName <small>@department.Employees.Count</small></h4>
                                                <ul>
                                                    @foreach (var person in department.Employees)
                                                    {
                                                        <li @key="person.EmployeeId">
                                                            <span class="pay-avatar c@(PayrollFormat.AvatarTone(person.DisplayName))">@PayrollFormat.Initials(person.DisplayName)</span>
                                                            <span class="org-person">
                                                                <strong>@person.DisplayName</strong>
                                                                <small>@person.EmployeeNumber · @(person.JobTitle ?? "No designation")@(person.ManagerName is { } manager ? " · reports to " + manager : null)</small>
                                                            </span>
                                                            <a class="emp-act-link" href="@Href($"employees/{person.EmployeeId}")" title="Edit employee">
                                                                <HrIcon Name="edit" Size="13" />
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </main>
</div>

@code {
    [Parameter] public string? TenantKey { get; set; }

    private enum OrgView { Chart, Reporting, Divisions }

    private const string ChartElementId = "hrOrgChart";

    private OrgView View = OrgView.Chart;
    private OrgHierarchyDto? Hierarchy;
    private IReadOnlyList<MasterOptionDto> AllOptions = [];
    private Dictionary<string, string?> Avatars = new(StringComparer.Ordinal);
    private readonly HashSet<string> Collapsed = [];
    private bool ChartPending = true;
    private bool ChartRendered;

    private string DivisionCode = string.Empty;
    private string DepartmentCode = string.Empty;
    private string Status = "Active";
    private string Search = string.Empty;

    private bool IsLoading = true;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var caller = await PortalCaller.GetAsync();
            AllOptions = await Masters.GetAllAsync(caller.TenantKey);

            try
            {
                // Photos only; the chart still works with initials when this account cannot read the explorer.
                var people = await Workspace.GetExplorerAsync(caller, new EmployeeExplorerQuery());
                Avatars = people.ToDictionary(p => p.EmployeeId, p => p.AvatarUrl, StringComparer.Ordinal);
            }
            catch (MobileAccessDeniedException)
            {
                Avatars = new(StringComparer.Ordinal);
            }
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;

        try
        {
            var caller = await PortalCaller.GetAsync();
            Hierarchy = await Reports.GetHierarchyAsync(caller, new EmployeeReportQuery
            {
                DivisionCode = DivisionCode,
                DepartmentCode = DepartmentCode,
                Status = Status,
                Search = Search
            });
        }
        catch (MobileAccessDeniedException denied)
        {
            Hierarchy = null;
            LoadError = $"This account does not hold {denied.Permission}, so the organization cannot be shown.";
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
            ChartPending = true;
        }
    }

    private void ShowChart()
    {
        View = OrgView.Chart;
        ChartPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (View != OrgView.Chart)
        {
            ChartRendered = false;
            return;
        }

        if (Hierarchy is not { TotalEmployees: > 0 } org || (!ChartPending && ChartRendered))
        {
            return;
        }

        ChartPending = false;
        ChartRendered = true;

        try
        {
            await JS.InvokeVoidAsync("hrOrgChart.render", ChartElementId, BuildChartNodes(org), new
            {
                title = "Kapson Organisation Chart",
                addUrl = Href("employees/new")
            });
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            LoadError = $"The organisation chart could not be drawn: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Flattens the reporting tree into the id / pid list the chart script draws, carrying the
    /// reporting path so a selected card can show who it rolls up to.
    /// </summary>
    private List<object> BuildChartNodes(OrgHierarchyDto org)
    {
        var nodes = new List<object>();

        void Walk(OrgHierarchyNodeDto node, string? parentId, string path)
        {
            var person = node.Employee;
            var breadcrumb = string.IsNullOrEmpty(path) ? person.DisplayName : $"{path} > {person.DisplayName}";

            nodes.Add(new
            {
                id = person.EmployeeId,
                pid = parentId,
                name = person.DisplayName,
                empCode = person.EmployeeNumber,
                designation = person.JobTitle,
                department = person.DepartmentName,
                departmentCode = person.DepartmentCode,
                division = person.DivisionName,
                grade = person.GradeName,
                photoUrl = Avatars.GetValueOrDefault(person.EmployeeId),
                directReportCount = node.Reports.Count,
                teamSize = node.TeamSize,
                isActive = person.IsActive,
                breadcrumb,
                editUrl = Href($"employees/{person.EmployeeId}")
            });

            foreach (var child in node.Reports)
            {
                Walk(child, person.EmployeeId, breadcrumb);
            }
        }

        foreach (var root in org.ReportingRoots)
        {
            Walk(root, null, string.Empty);
        }

        return nodes;
    }

    private static IEnumerable<(string Code, string Name)> LegendDepartments(OrgHierarchyDto org)
    {
        var seen = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        void Walk(OrgHierarchyNodeDto node)
        {
            seen.TryAdd(node.Employee.DepartmentCode ?? string.Empty, node.Employee.DepartmentName);
            foreach (var child in node.Reports)
            {
                Walk(child);
            }
        }

        foreach (var root in org.ReportingRoots)
        {
            Walk(root);
        }

        return seen.OrderBy(kv => kv.Value).Select(kv => (kv.Key, kv.Value));
    }

    // Mirrors DEPT_COLORS in hr-orgchart.js so the legend matches the card headers.
    private static readonly string[] FallbackColors = ["#1976D2", "#00897B", "#5E35B1", "#EF6C00", "#2E7D32", "#AD1457"];

    private static string DeptColor(string? code)
    {
        var key = (code ?? string.Empty).ToUpperInvariant();
        switch (key)
        {
            case "HR": return "#1565C0";
            case "FINOPS": return "#FFD600";
            case "DIGITAL": return "#0288D1";
            case "RETAIL": return "#0097A7";
            case "BRAND": return "#6A4FC8";
        }

        var hash = 0;
        foreach (var ch in key)
        {
            hash = unchecked(hash * 31 + ch);
        }

        return FallbackColors[Math.Abs(hash % FallbackColors.Length)];
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hrOrgChart.dispose", ChartElementId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task ChangeAsync(Action change)
    {
        change();
        await LoadAsync();
    }

    private void Toggle(string employeeId)
    {
        if (!Collapsed.Remove(employeeId))
        {
            Collapsed.Add(employeeId);
        }
    }

    private void ExpandAll() => Collapsed.Clear();

    private void CollapseAll(OrgHierarchyDto org)
    {
        Collapsed.Clear();
        foreach (var root in org.ReportingRoots.Where(root => root.Reports.Count > 0))
        {
            Collapsed.Add(root.Employee.EmployeeId);
        }
    }

    private RenderFragment NodeView(OrgHierarchyNodeDto node) => __builder =>
    {
        var person = node.Employee;
        var hasReports = node.Reports.Count > 0;
        var isOpen = hasReports && !Collapsed.Contains(person.EmployeeId);

        <li @key="person.EmployeeId">
            <div class="org-node @(person.IsActive ? null : "inactive")">
                @if (hasReports)
                {
                    <button class="org-toggle" type="button" aria-expanded="@isOpen"
                            aria-label="@(isOpen ? "Collapse" : "Expand") @person.DisplayName's team"
                            @onclick="() => Toggle(person.EmployeeId)">@(isOpen ? "▾" : "▸")</button>
                }
                else
                {
                    <span class="org-toggle-spacer"></span>
                }
                <span class="pay-avatar c@(PayrollFormat.AvatarTone(person.DisplayName))">@PayrollFormat.Initials(person.DisplayName)</span>
                <span class="org-person">
                    <strong>@person.DisplayName</strong>
                    <small>@person.EmployeeNumber · @(person.JobTitle ?? "No designation")</small>
                    <small>@person.DepartmentName · @person.DivisionName@(person.GradeName is { } grade ? " · " + grade : null)</small>
                </span>
                @if (hasReports)
                {
                    <span class="org-team" title="Everyone in this person's reporting line">👥 @node.TeamSize</span>
                }
                @if (!person.IsActive)
                {
                    <span class="hr-tag tone-neutral">Inactive</span>
                }
                <a class="emp-act-link" href="@Href($"employees/{person.EmployeeId}")" title="Edit employee">
                    <HrIcon Name="edit" Size="14" /> Edit
                </a>
            </div>
            @if (isOpen)
            {
                <ul>
                    @foreach (var child in node.Reports)
                    {
                        @NodeView(child)
                    }
                </ul>
            }
        </li>
    };

    private IEnumerable<MasterOptionDto> Options(string category) =>
        AllOptions.Where(option => option.Category == category && option.IsActive)
            .OrderBy(option => option.SortOrder).ThenBy(option => option.Name);

    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;

    private string Href(string suffix) =>
        string.IsNullOrWhiteSpace(TenantKey) ? $"/hr/{suffix}" : $"/hr/{TenantKey}/{suffix}";
}
