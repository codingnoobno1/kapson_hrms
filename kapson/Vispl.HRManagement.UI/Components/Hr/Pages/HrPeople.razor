@page "/hr/people"
@page "/hr/{TenantKey}/people"
@page "/hr/employees"
@page "/hr/{TenantKey}/employees"
@attribute [Authorize(Policy = "HrPortal")]
@using System.Globalization
@using Microsoft.JSInterop
@using Vispl.HRManagement.BM.ITF.Admin
@using Vispl.HRManagement.BM.ITF.Mobile
@using Vispl.HRManagement.BM.ITF.Shared
@using Vispl.HRManagement.Contracts.Admin
@using Vispl.HRManagement.UI.Components.Hr.Shared
@inject IEmployeeWorkspaceService Workspace
@inject IMasterDataService Masters
@inject IExcelExporter Excel
@inject HrPortalCaller PortalCaller
@inject IJSRuntime JS

<PageTitle>Employees Explorer | HR Portal</PageTitle>

<div class="hr-app">
    <HrNav ActivePage="people" TenantKey="@TenantKey" />

    <main class="hr-page">
        <h1 class="hr-title-blue">Employees Explorer</h1>
        <nav class="hr-breadcrumb" aria-label="Breadcrumb">
            <a href="@Href("dashboard")">Dashboard</a>
            <span aria-hidden="true"><HrIcon Name="chevron-right" Size="15" StrokeWidth="2.2" /></span>
            <strong>Employees Explorer</strong>
        </nav>

        <HrEmployeeTabs ActiveTab="explorer" TenantKey="@TenantKey" />

        @if (LoadError is not null)
        {
            <div class="hr-alert error">@LoadError</div>
        }
        else
        {
            <section class="org-tiles emp-mt-sm">
                <div><span>Total Records</span><strong>@Rows.Count</strong></div>
                <div><span>Active</span><strong>@Rows.Count(r => r.IsActive && !r.IsDraft)</strong></div>
                <div class="@(Rows.Any(r => r.IsDraft) ? "warn" : null)">
                    <span>Drafts</span><strong>@Rows.Count(r => r.IsDraft)</strong>
                </div>
                <div><span>Exited</span><strong>@Rows.Count(r => !r.IsActive && !r.IsDraft)</strong></div>
            </section>

            <section class="hr-panel emp-explorer-card">
                <div class="emp-explorer-toolbar">
                    <div class="emp-explorer-filters">
                        <label class="emp-field">
                            <span class="emp-label">Search</span>
                            <input type="search" placeholder="Name, code, email or mobile…"
                                   value="@Search"
                                   @oninput="e => { Search = e.Value?.ToString() ?? string.Empty; PageIndex = 0; }"
                                   @onkeydown="OnSearchKeyAsync" />
                        </label>

                        <label class="emp-field">
                            <span class="emp-label">Division</span>
                            <select value="@DivisionCode" @onchange="e => ApplyFilterAsync(() => DivisionCode = e.Value?.ToString() ?? string.Empty)">
                                <option value="">All Divisions</option>
                                @foreach (var opt in Options(MasterCategories.Division))
                                {
                                    <option @key="opt.Code" value="@opt.Code">@opt.Name</option>
                                }
                            </select>
                        </label>

                        <label class="emp-field">
                            <span class="emp-label">Department</span>
                            <select value="@DepartmentCode" @onchange="e => ApplyFilterAsync(() => DepartmentCode = e.Value?.ToString() ?? string.Empty)">
                                <option value="">All Departments</option>
                                @foreach (var opt in Options(MasterCategories.Department).Where(d => string.IsNullOrWhiteSpace(d.ParentCode)))
                                {
                                    <option @key="opt.Code" value="@opt.Code">@opt.Name</option>
                                }
                            </select>
                        </label>

                        <label class="emp-field">
                            <span class="emp-label">Status</span>
                            <select value="@Status" @onchange="e => ApplyFilterAsync(() => Status = e.Value?.ToString() ?? string.Empty)">
                                <option value="">Everyone</option>
                                <option value="Active">Active</option>
                                <option value="Draft">Draft</option>
                                <option value="OnLeave">On Leave</option>
                                <option value="Exited">Exited</option>
                            </select>
                        </label>
                    </div>

                    <div class="emp-explorer-actions">
                        <a class="hr-button small ghost" href="@Href("people/change-requests")">Change Requests</a>
                        <a class="hr-button small ghost" href="@Href("payroll/bank-accounts")">Bank Accounts</a>
                        <button type="button" class="hr-button small ghost" disabled="@(FilteredRows.Count == 0)" @onclick="ExportAsync">
                            <HrIcon Name="download" Size="14" /> Export
                        </button>
                        @if (CanCreate)
                        {
                            <a class="hr-button small" href="@Href("employees/new")">
                                <HrIcon Name="plus" Size="14" StrokeWidth="2.4" /> Add New Employee
                            </a>
                        }
                    </div>
                </div>

                @if (IsLoading)
                {
                    <div class="hr-table-skeleton">
                        @for (var i = 0; i < 6; i++)
                        {
                            <span></span>
                        }
                    </div>
                }
                else
                {
                    <div class="emp-table-wrap">
                        <table class="emp-table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Designation</th>
                                    <th>Department</th>
                                    <th>Division</th>
                                    <th>Grade</th>
                                    <th>Mobile</th>
                                    <th>Email</th>
                                    <th>Reporting Manager</th>
                                    <th>Joining Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (PagedRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="11" class="emp-empty-cell">
                                            @(Rows.Count == 0 ? "No employees added yet. Click '+ Add New Employee' to create one." : "No employees match the selected filters.")
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in PagedRows)
                                    {
                                        <tr @key="row.EmployeeId">
                                            <td>
                                                <div class="emp-person-cell">
                                                    @if (!string.IsNullOrWhiteSpace(row.AvatarUrl))
                                                    {
                                                        <img class="emp-row-photo" src="@row.AvatarUrl" alt="@row.DisplayName" />
                                                    }
                                                    else
                                                    {
                                                        <span class="pay-avatar c@(PayrollFormat.AvatarTone(row.DisplayName))">@PayrollFormat.Initials(row.DisplayName)</span>
                                                    }
                                                    <div class="emp-person-meta">
                                                        <strong>@row.DisplayName</strong>
                                                        <small>@row.EmployeeNumber</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@(row.Designation ?? "—")</td>
                                            <td>
                                                @row.DepartmentName
                                                @if (!string.IsNullOrWhiteSpace(row.SubDepartmentName))
                                                {
                                                    <small class="emp-sub-meta">@row.SubDepartmentName</small>
                                                }
                                            </td>
                                            <td>@row.DivisionName</td>
                                            <td>@(row.GradeName ?? "—")</td>
                                            <td>@(row.Phone ?? "—")</td>
                                            <td>@(row.Email ?? "—")</td>
                                            <td>@(row.ManagerName ?? "—")</td>
                                            <td>@row.JoinedOn.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                            <td>
                                                <span class="hr-tag tone-@row.StatusTone">@row.StatusLabel</span>
                                            </td>
                                            <td class="emp-row-actions">
                                                <a class="emp-act-link" href="@Href($"employees/{row.EmployeeId}")">
                                                    <HrIcon Name="edit" Size="14" /> Edit
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (FilteredRows.Count > PageSize)
                    {
                        <div class="emp-pager">
                            <span>Showing @(PageIndex * PageSize + 1)–@Math.Min((PageIndex + 1) * PageSize, FilteredRows.Count) of @FilteredRows.Count</span>
                            <div class="emp-pager-btns">
                                <button type="button" class="hr-button small ghost" disabled="@(PageIndex == 0)" @onclick="() => PageIndex--">Previous</button>
                                <button type="button" class="hr-button small ghost" disabled="@((PageIndex + 1) * PageSize >= FilteredRows.Count)" @onclick="() => PageIndex++">Next</button>
                            </div>
                        </div>
                    }
                }
            </section>
        }
    </main>
</div>

@code {
    [Parameter] public string? TenantKey { get; set; }

    private const int PageSize = 25;

    private IReadOnlyList<EmployeeExplorerRowDto> Rows = [];
    private IReadOnlyList<MasterOptionDto> AllOptions = [];

    private string Search = string.Empty;
    private string DivisionCode = string.Empty;
    private string DepartmentCode = string.Empty;
    private string Status = string.Empty;
    private int PageIndex;

    private bool IsLoading = true;
    private bool CanCreate;
    private string? LoadError;

    private IReadOnlyList<EmployeeExplorerRowDto> FilteredRows =>
        string.IsNullOrWhiteSpace(Search)
            ? Rows
            : Rows.Where(r =>
                r.DisplayName.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                r.EmployeeNumber.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (r.Designation?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Email?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Phone?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

    private IReadOnlyList<EmployeeExplorerRowDto> PagedRows =>
        FilteredRows.Skip(PageIndex * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var caller = await PortalCaller.GetAsync();
            CanCreate = await PortalCaller.HasAsync("EMPLOYEES.CREATE");
            AllOptions = await Masters.GetAllAsync(caller.TenantKey);
            await ReloadAsync();
        }
        catch (MobileAccessDeniedException denied)
        {
            LoadError = $"This account requires {denied.Permission} to view Employees Explorer.";
            IsLoading = false;
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
            IsLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        IsLoading = true;
        PageIndex = 0;

        try
        {
            var caller = await PortalCaller.GetAsync();
            Rows = await Workspace.GetExplorerAsync(caller, new EmployeeExplorerQuery
            {
                DivisionCode = DivisionCode,
                DepartmentCode = DepartmentCode,
                Status = Status
            });
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFilterAsync(Action update)
    {
        update();
        await ReloadAsync();
    }

    private async Task OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ReloadAsync();
        }
    }

    private async Task ExportAsync()
    {
        var list = FilteredRows.ToList();
        var sheet = new ExcelSheet(
            "Employees Explorer",
            "Employees Explorer Directory",
            $"{list.Count} employee(s) · exported {DateTime.Now:dd MMM yyyy, h:mm tt}",
            [
                new("Employee Code"), new("Name"), new("Designation"), new("Department"), new("Sub-Department"),
                new("Division"), new("Location"), new("Grade"), new("Joined", ExcelFormat.Date),
                new("Status"), new("Reporting Manager"), new("Mobile"), new("Email")
            ],
            list.Select(r => ExcelDownload.Row(
                r.EmployeeNumber, r.DisplayName, r.Designation, r.DepartmentName, r.SubDepartmentName,
                r.DivisionName, r.LocationName, r.GradeName, r.JoinedOn,
                r.StatusLabel, r.ManagerName, r.Phone, r.Email)).ToList());

        await ExcelDownload.SaveAsync(JS, Excel, $"employees-explorer-{DateTime.Today:yyyy-MM-dd}.xlsx", sheet);
    }

    private IEnumerable<MasterOptionDto> Options(string category) =>
        AllOptions.Where(o => o.Category == category && o.IsActive)
            .OrderBy(o => o.SortOrder).ThenBy(o => o.Name);

    private string Href(string suffix) =>
        string.IsNullOrWhiteSpace(TenantKey) ? $"/hr/{suffix}" : $"/hr/{TenantKey}/{suffix}";
}
