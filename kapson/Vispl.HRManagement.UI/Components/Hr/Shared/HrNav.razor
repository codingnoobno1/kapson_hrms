@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Vispl.HRManagement.BM.ITF.Mobile
@using Vispl.HRManagement.BM.ITF.Shared
@using Vispl.HRManagement.Contracts.Mobile.Home
@inject AuthenticationStateProvider Authentication
@inject HrPortalCaller PortalCaller
@inject IMobileNotificationService Notifications
@inject ITenantClock Clock
@inject NavigationManager Navigation

@*
    The locked HR chrome (phase D, D-3): the blue left sidebar and the blue top bar from the
    attendance report and W08 screens, plus the four-tab app menu behind ☰. Every HR page renders
    this inside .hr-app, which lays the sidebar, the top bar and the page out as a grid — so no page
    changes to get the new frame.
*@

@code {
    [Parameter] public string ActivePage { get; set; } = "";

    /// <summary>Keeps every link inside the client's own portal once one is in the address.</summary>
    [Parameter] public string? TenantKey { get; set; }

    private const string TabAppConfiguration = "app-configuration";
    private const string TabEmployee = "employee";
    private const string TabSalaryManagement = "salary-management";
    private const string TabEmployeeReport = "employee-report";

    private bool _menuOpen;
    private bool _userMenuOpen;
    private bool _collapsed;
    private string _activeTab = TabAppConfiguration;

    private string _displayName = "HR user";
    private string _roleLabel = "HR Portal";
    private string _today = DateTime.Today.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    private string _lastLogin = "—";
    private long _unread;

    private sealed record NavItem(string Label, string Icon, string Suffix);

    // The locked sidebar, top to bottom. A fragment link (#…) opens the section on that page.
    private static readonly (string Caption, NavItem[] Items)[] Groups =
    [
        ("Dashboard", [new("Dashboard", "grid", "dashboard")]),
        ("Employee",
        [
            new("New Employee", "plus-square", "employees/new"),
            new("Birthday", "cake", "dashboard#birthdays"),
            new("Anniversaries", "ring", "dashboard#anniversaries")
        ]),
        ("Attendance",
        [
            new("Last Coming", "clock", "attendance#late"),
            new("Miss Punch", "alert", "attendance#miss-punch"),
            new("Attendance Overview", "users", "reports/attendance-monthly")
        ]),
        ("Leave Management",
        [
            new("Pending Approval", "hourglass", "leave"),
            new("Leave Balance", "bar-chart", "leave#balances")
        ]),
        ("Out & Pass",
        [
            new("Going Out", "user-out", "attendance#movement"),
            new("Gate Pass", "id-card", "attendance#gate-pass")
        ]),
        ("Calendar", [new("Events & Holidays", "calendar", "dashboard#events")]),
        ("Reports", [new("Analytics", "trending-up", "attendance")]),

        // Not in the locked screenshots, which stop at Reports: without these the portal would lose
        // its way to people, recruitment and settings. Settings is also behind ☰.
        ("More",
        [
            new("People", "users", "people"),
            new("Recruitment", "briefcase", "recruitment"),
            new("Settings", "settings", "settings")
        ])
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await Authentication.GetAuthenticationStateAsync();
            var user = state.User;

            _displayName = user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? "HR user";

            var role = user.FindAll(ClaimTypes.Role).Select(claim => claim.Value).FirstOrDefault();
            _roleLabel = role is null ? "HR Portal" : Pretty(role);

            if (DateTimeOffset.TryParse(user.FindFirst("previous_login_utc")?.Value, CultureInfo.InvariantCulture,
                    DateTimeStyles.RoundtripKind, out var previous))
            {
                _lastLogin = previous.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);
            }

            var caller = await PortalCaller.GetAsync();
            _today = (await Clock.TodayAsync(caller.TenantKey)).ToString("MMM d, yyyy", CultureInfo.InvariantCulture);

            var unread = await Notifications.ListAsync(
                caller, new NotificationListQuery { UnreadOnly = true, PageSize = 1 }, CancellationToken.None);
            _unread = unread.ApproximateTotal ?? unread.Items.Count;
        }
        catch (Exception)
        {
            // The frame never blocks a page: a count that cannot be read shows no badge.
        }
    }

    private bool IsActive(NavItem item)
    {
        if (item.Suffix.Contains('#'))
        {
            return false;
        }

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var segments = relative.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (segments.Count > 0 && segments[0] == "hr")
        {
            segments.RemoveAt(0);
        }

        if (!string.IsNullOrWhiteSpace(TenantKey) && segments.Count > 0 &&
            string.Equals(segments[0], TenantKey, StringComparison.OrdinalIgnoreCase))
        {
            segments.RemoveAt(0);
        }

        return string.Equals(string.Join('/', segments), item.Suffix, StringComparison.OrdinalIgnoreCase);
    }

    private string Path(string suffix) =>
        string.IsNullOrWhiteSpace(TenantKey) ? $"/hr/{suffix}" : $"/hr/{TenantKey}/{suffix}";

    private static string Pretty(string role) =>
        CultureInfo.InvariantCulture.TextInfo.ToTitleCase(role.Replace('_', ' ').ToLowerInvariant());

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
    private void SelectTab(string tab) => _activeTab = tab;
}

<aside class="hr-sidebar @(_collapsed ? "collapsed" : null)" aria-label="HR portal navigation">
    <button type="button" class="hr-sidebar-toggle" aria-label="@(_collapsed ? "Expand navigation" : "Collapse navigation")"
            @onclick="() => _collapsed = !_collapsed">
        <HrIcon Name="menu" Size="22" StrokeWidth="2" />
    </button>

    @foreach (var (caption, items) in Groups)
    {
        <div class="hr-sidebar-group">
            <span class="hr-sidebar-caption">@caption</span>
            @foreach (var item in items)
            {
                <a class="hr-sidebar-link @(IsActive(item) ? "active" : null)" href="@Path(item.Suffix)" title="@item.Label">
                    <HrIcon Name="@item.Icon" Size="21" StrokeWidth="1.7" />
                    <span>@item.Label</span>
                </a>
            }
        </div>
    }
</aside>

<header class="hr-topbar">
    <a class="hr-topbar-brand" href="@Path("dashboard")">
        <svg class="hr-topbar-logo" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="hrTopbarLogo" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#7FF0F2" />
                    <stop offset="1" stop-color="#2F8BF0" />
                </linearGradient>
            </defs>
            <rect x="5" y="3" width="10" height="34" rx="5" fill="url(#hrTopbarLogo)" />
            <path d="M17 21c0-6.5 5-11 11.5-11H32v9.5C32 28.5 25.5 37 17 37z" fill="url(#hrTopbarLogo)" />
        </svg>
        <span class="hr-topbar-title">
            <span><strong>HR</strong> Management, Dashboard</span>
            <small>Employee Leave Status, Attendance &amp; Milestone Tracking System</small>
        </span>
    </a>

    <div class="hr-topbar-meta">
        <span><HrIcon Name="calendar" Size="15" /> CURRENT: <strong>@_today</strong></span>
        <i aria-hidden="true"></i>
        <span><HrIcon Name="clock" Size="15" /> LAST LOGIN: <strong>@_lastLogin</strong></span>
    </div>

    <a class="hr-topbar-bell" href="@Path("dashboard")" aria-label="@($"{_unread} unread notifications")">
        <HrIcon Name="bell" Size="21" />
        @if (_unread > 0)
        {
            <b>@(_unread > 99 ? "99+" : _unread.ToString(CultureInfo.InvariantCulture))</b>
        }
    </a>

    <div class="hr-topbar-user">
        <span class="hr-topbar-avatar" aria-hidden="true">@Initials(_displayName)</span>
        <span class="hr-topbar-who">
            <strong>@_displayName</strong>
            <small>@_roleLabel</small>
        </span>
        <button type="button" class="hr-topbar-chevron" aria-label="Account menu"
                aria-expanded="@_userMenuOpen.ToString().ToLowerInvariant()" @onclick="() => _userMenuOpen = !_userMenuOpen">
            <HrIcon Name="chevron-down" Size="14" StrokeWidth="2.8" />
        </button>
        @if (_userMenuOpen)
        {
            <div class="hr-topbar-dropdown">
                <a href="@Path("change-password")">Change password</a>
                <form method="post" action="/identity/hr/logout">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            </div>
        }
    </div>

    @*
        The app-menu trigger. Opens the same four-tab catalogue the design puts behind a hamburger,
        as an overlay above whatever page is already open (scopedocs/web-portal/08 §3.1-§3.2).
    *@
    <button type="button" class="hr-topbar-menu" aria-label="Open app menu"
            aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" @onclick="ToggleMenu">
        <HrIcon Name="menu" Size="26" StrokeWidth="2.2" />
    </button>
</header>

@if (_menuOpen)
{
    <div class="hr-mega-menu-backdrop" @onclick="CloseMenu"></div>

    <div class="hr-mega-menu" role="dialog" aria-modal="true" aria-label="App menu">
        <div class="hr-mega-menu-tabs">
            <button type="button" class="hr-mega-menu-tab @(_activeTab == TabAppConfiguration ? "active" : "")"
                    @onclick="() => SelectTab(TabAppConfiguration)">⚙️ APP Configuration</button>
            <button type="button" class="hr-mega-menu-tab @(_activeTab == TabEmployee ? "active" : "")"
                    @onclick="() => SelectTab(TabEmployee)">👤 Employee</button>
            <button type="button" class="hr-mega-menu-tab @(_activeTab == TabSalaryManagement ? "active" : "")"
                    @onclick="() => SelectTab(TabSalaryManagement)">💰 Salary Management</button>
            <button type="button" class="hr-mega-menu-tab @(_activeTab == TabEmployeeReport ? "active" : "")"
                    @onclick="() => SelectTab(TabEmployeeReport)">👥 Employee Report</button>

            <button type="button" class="hr-mega-menu-close" aria-label="Close app menu" @onclick="CloseMenu">✕</button>
        </div>

        <div class="hr-mega-menu-body">
            @if (_activeTab == TabAppConfiguration)
            {
                <HrMasterCardGrid TenantKey="@TenantKey" />
            }
            else if (_activeTab == TabEmployee)
            {
                <HrMenuCardSection Title="Employee" Cards="HrMegaMenuRegistry.EmployeeCards(TenantKey)" />
            }
            else if (_activeTab == TabSalaryManagement)
            {
                <HrMenuCardSection Title="Salary Management" Cards="HrMegaMenuRegistry.SalaryManagementCards(TenantKey)" />
            }
            else if (_activeTab == TabEmployeeReport)
            {
                <HrMenuCardSection Title="Employee Management" Cards="HrMegaMenuRegistry.EmployeeReportCards(TenantKey)" />
            }
        </div>
    </div>
}
