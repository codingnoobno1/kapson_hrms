@*
    The line icons of the client-locked System Settings screens (refresh, search, more, add, set
    order, edit, delete, breadcrumb chevron). Inline SVG in currentColor, so an icon takes the
    colour and hover state of the button it sits in. Text glyphs and emoji were not used: they
    render differently per font and the delete bin came out as a colour emoji.
*@

<svg class="hr-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "refresh":
            <path d="M21 12a9 9 0 1 1-2.64-6.36" />
            <path d="M21 3v6h-6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
            break;
        case "more-vertical":
            <circle cx="12" cy="5" r="1.2" fill="currentColor" />
            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
            <circle cx="12" cy="19" r="1.2" fill="currentColor" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "move":
            <path d="M12 3v18M3 12h18" />
            <path d="m9 6 3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3" />
            break;
        case "edit":
            <path d="M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
            <path d="M18.4 2.6a2 2 0 0 1 3 3L12 15l-4 1 1-4Z" />
            break;
        case "trash":
            <path d="M3 6h18" />
            <path d="M8 6V4h8v2" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <path d="M10 11v6M14 11v6" />
            break;
        case "chevron-right":
            <path d="m9 6 6 6-6 6" />
            break;
        case "grid":
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
            break;
        case "plus-square":
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <path d="M12 8v8M8 12h8" />
            break;
        case "cake":
            <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8" />
            <path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1" />
            <path d="M2 21h20M7 8v3M12 8v3M17 8v3M7 4h.01M12 4h.01M17 4h.01" />
            break;
        case "ring":
            <circle cx="12" cy="15" r="6.5" />
            <path d="m9 3 3 5 3-5" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "alert":
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4M12 17h.01" />
            break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            break;
        case "hourglass":
            <path d="M5 22h14M5 2h14M17 22v-4.2a2 2 0 0 0-.6-1.4L12 12l-4.4 4.4a2 2 0 0 0-.6 1.4V22M7 2v4.2a2 2 0 0 0 .6 1.4L12 12l4.4-4.4a2 2 0 0 0 .6-1.4V2" />
            break;
        case "bar-chart":
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M8 17v-5M12 17V8M16 17v-3" />
            break;
        case "user-out":
            <circle cx="9" cy="7" r="4" />
            <path d="M3 21v-2a4 4 0 0 1 4-4h4M16 17h6M19 14l3 3-3 3" />
            break;
        case "id-card":
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <circle cx="8" cy="11" r="2" />
            <path d="M5 16c.5-1.2 1.6-2 3-2s2.5.8 3 2M14 10h5M14 14h3" />
            break;
        case "calendar":
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
            break;
        case "trending-up":
            <path d="M3 3v18h18" />
            <path d="m7 15 4-4 3 3 6-6" />
            break;
        case "bell":
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "briefcase":
            <rect x="2" y="7" width="20" height="14" rx="2" />
            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case "print":
            <path d="M6 9V2h12v7" />
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
            <rect x="6" y="14" width="12" height="8" />
            break;
        case "download":
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            break;
        case "sliders":
            <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" />
            break;
        case "arrow-left":
            <path d="M19 12H5M12 19l-7-7 7-7" />
            break;
        case "arrow-right":
            <path d="M5 12h14M12 5l7 7-7 7" />
            break;
        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "table":
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M3 9h18M3 15h18M9 3v18" />
            break;
        case "arrow-up":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;
        case "arrow-down":
            <path d="M12 5v14M19 12l-7 7-7-7" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public double StrokeWidth { get; set; } = 1.8;
}
