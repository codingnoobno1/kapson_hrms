{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "ApplicationName": "Vispl.HRManagement",
    "KeysPath": ".data-protection-keys"
  },
  "Database": {
    "InitializeOnStartup": true,
    "SeedOnEmpty": true,
    "SeedDataPath": "SeedData"
  },
  "BootstrapAdmin": {
    "UserName": "admin",
    "DisplayName": "Vertex Administrator"
  },
  "MediaStorage": {
    "RootPath": ".data/media"
  },
  "MobileApi": {
    "ApiVersion": "1.0",
    "MinimumAppVersion": "0.1.0",
    "Authority": "",
    "Audience": "vispl.hr.api",
    "RequireHttpsMetadata": true,
    "StatusUrl": "/api/mobile/v1/discovery/metadata",
    "SupportedPlatforms": [
      "android",
      "ios"
    ],
    "LegalLinks": {}
  },
  "AllowedHosts": "*",
  "Mail": {
    "SenderBaseUrl": "http://localhost:7001",
    "ReceiverBaseUrl": "http://localhost:7002",
    "PublicBaseUrl": "http://localhost:7000",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "Enabled": true
  }
}
