<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Vispl.HRManagement.Mobile.Shared.Controls.KpiTile"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Vispl.HRManagement.Mobile.Shared.Controls"
    x:DataType="controls:KpiTile">
    <Border MinimumWidthRequest="112" HeightRequest="128" Padding="14" StrokeThickness="0"
            BackgroundColor="{Binding Item.Accent, Source={x:Reference Root}, Converter={StaticResource AccentColorConverter}}">
        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Padding="8,4" HorizontalOptions="Start" BackgroundColor="#25FFFFFF" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                <Label Text="{Binding Item.Symbol, Source={x:Reference Root}}" TextColor="White" FontSize="10" FontAttributes="Bold" />
            </Border>
            <Label Grid.Row="1" Text="{Binding Item.Title, Source={x:Reference Root}}" TextColor="White" FontSize="13" VerticalOptions="End" />
            <Label Grid.Row="2" Text="{Binding Item.Value, Source={x:Reference Root}}" TextColor="White" FontSize="30" FontAttributes="Bold" />
        </Grid>
    </Border>
</ContentView>
