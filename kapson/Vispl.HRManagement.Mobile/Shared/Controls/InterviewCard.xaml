<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Vispl.HRManagement.Mobile.Shared.Controls.InterviewCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Vispl.HRManagement.Mobile.Shared.Controls"
    x:DataType="controls:InterviewCard">
    <Border Padding="14" BackgroundColor="{StaticResource BlueTint}" Stroke="#C9D9FB" StrokeThickness="1">
        <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
            <Label Text="{Binding Item.CandidateName, Source={x:Reference Root}}" FontAttributes="Bold" FontSize="15" />
            <controls:StatusPill Grid.Column="1" Status="{Binding Item.Status, Source={x:Reference Root}}" />
            <Label Grid.Row="1" Text="{Binding Item.JobTitle, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
                <Label Text="{Binding Item.StartsAt, Source={x:Reference Root}, StringFormat='{}{0:dd MMM · HH:mm}'}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Item.Round, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
