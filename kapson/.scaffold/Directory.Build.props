<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Vispl.HRManagement.Identity'
                     Or '$(MSBuildProjectName)' == 'Vispl.HRManagement.Composition'
                     Or '$(MSBuildProjectName)' == 'Vispl.HRManagement.Worker'
                     Or '$(MSBuildProjectName)' == 'Vispl.HRManagement.UI'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
