@* Line icon set matching the reference screenshots: 24px grid, 1.75 stroke, round caps,
   painted in currentColor so a parent's colour carries through to the glyph. *@
@* A caller that has no icon for a row passes an empty name; drawing the fallback
   glyph there would invent a meaning the screen never asked for. *@
@if (!string.IsNullOrWhiteSpace(Name))
{
    <svg class="icon @(Class)" width="@Size" height="@Size" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="@StrokeWidth"
         stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="@(Label is null ? "true" : "false")"
         role="@(Label is null ? "presentation" : "img")">
        @if (Label is not null)
        {
            <title>@Label</title>
        }
        @((MarkupString)Glyph)
    </svg>
}

