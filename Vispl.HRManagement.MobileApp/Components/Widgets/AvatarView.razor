@* RW-32 AvatarView. Falls back to a neutral person glyph on the placeholder fill. *@
<div class="avatar @(Small ? "avatar-sm" : "")" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="" />
    }
    else
    {
        <AppIcon Name="user" Size="@(Small ? 18 : 26)" StrokeWidth="1.5" />
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public bool Small { get; set; }
}
